{
  "name": "@ai-mae-check/llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./wasm-worker": {
      "types": "./dist/wasm-worker.d.ts",
      "import": "./dist/wasm-worker.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @ai-mae-check/core build && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "pnpm --filter @ai-mae-check/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-mae-check/core": "workspace:*",
    "@huggingface/transformers": "3.8.1",
    "@mlc-ai/web-llm": "^0.2.79",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  }
}
