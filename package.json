{
  "name": "ai-mae-check",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:site",
    "dev:extension": "pnpm --filter @ai-mae-check/core build && pnpm --filter @ai-mae-check/llm build && pnpm --filter @ai-mae-check/extension dev",
    "dev:site": "pnpm --filter @ai-mae-check/core build && pnpm --filter @ai-mae-check/llm build && pnpm --filter @ai-mae-check/site dev",
    "build": "pnpm -r --sort build",
    "build:extension": "pnpm --filter @ai-mae-check/core build && pnpm --filter @ai-mae-check/llm build && pnpm --filter @ai-mae-check/extension build",
    "build:extension:e2e": "node scripts/build-extension-e2e.mjs",
    "build:site": "pnpm --filter @ai-mae-check/core build && pnpm --filter @ai-mae-check/llm build && pnpm --filter @ai-mae-check/site build",
    "build:pages": "pnpm build:site && tsx scripts/sign-github-pages-rules.ts",
    "package:extension": "node scripts/package-extension-release.mjs",
    "test": "pnpm eval:dlp && pnpm test:pages && pnpm --filter @ai-mae-check/core test && pnpm --filter @ai-mae-check/llm test && pnpm --filter @ai-mae-check/site test && pnpm --filter @ai-mae-check/extension test",
    "test:core": "pnpm --filter @ai-mae-check/core test",
    "test:site": "pnpm --filter @ai-mae-check/site test",
    "test:llm": "pnpm --filter @ai-mae-check/llm test",
    "test:pages": "vitest run scripts/github-pages-rule-delivery.test.ts scripts/chrome-web-store-publication.test.ts",
    "test:e2e": "pnpm --filter @ai-mae-check/site test:e2e",
    "test:extension:e2e": "node scripts/run-extension-e2e.mjs",
    "eval:dlp": "vitest run scripts/eval-dlp.test.ts --reporter=verbose",
    "lint": "biome ci . --diagnostic-level=error && node scripts/check-static-lint.mjs",
    "lint:report": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r --sort typecheck",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:screenshots": "node scripts/capture-public-screenshots.mjs",
    "rules:keygen": "node scripts/generate-rule-keypair.mjs",
    "qa:public-repo": "node scripts/check-public-repo-safety.mjs",
    "qa:public-docs": "node scripts/check-public-docs-sync.mjs",
    "qa:privacy-regression": "node scripts/check-privacy-regression.mjs",
    "qa:performance-budget": "node scripts/check-performance-budget-doc.mjs",
    "qa:local-ai-model-policy": "node scripts/check-local-ai-model-policy.mjs",
    "qa:local-ai-compatibility": "node scripts/check-local-ai-compatibility.mjs",
    "qa:rule-catalog": "node scripts/check-rule-catalog.mjs",
    "qa:rules:production": "node scripts/verify-production-rule-delivery.mjs",
    "qa:extension:e2e-harness": "node scripts/check-extension-e2e-harness-doc.mjs",
    "qa:test-maintenance": "node scripts/check-test-maintenance.mjs",
    "qa:script-maintenance": "node scripts/check-script-maintenance.mjs",
    "qa:dependency-policy": "node scripts/check-dependency-policy.mjs",
    "qa:tailwind4": "node scripts/check-tailwind4.mjs",
    "qa:release-policy": "node scripts/check-release-policy.mjs",
    "qa:issue-pr-workflow": "node scripts/check-issue-pr-workflow.mjs",
    "qa:github-metadata": "node scripts/check-github-metadata.mjs",
    "qa:site:publication": "node scripts/check-site-publication.mjs",
    "qa:github-pages": "node scripts/check-github-pages-readiness.mjs",
    "qa:portfolio-case-study": "node scripts/check-portfolio-case-study.mjs",
    "qa:extension:size": "node scripts/check-extension-size-budget.mjs",
    "qa:extension:manifest": "node scripts/check-extension-manifest.mjs",
    "qa:chrome-store": "node scripts/check-chrome-store-readiness.mjs",
    "qa:chrome-store:published": "node scripts/check-published-chrome-store.mjs",
    "bench:rules": "vitest run scripts/bench-rule-detection.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.29",
    "@vitejs/plugin-react": "^4.5.2",
    "@wxt-dev/module-react": "^1.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
